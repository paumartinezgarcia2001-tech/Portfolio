{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-09-16",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Las variables de texto puestas en el panel (Settings → Variables and
	// Secrets) no se borran en cada `wrangler deploy` de Workers Builds.
	"keep_vars": true,
	"observability": {
		"enabled": true
	}
	// Variables públicas: en "vars" (o en el panel de Cloudflare).
	// Secretos: `npx wrangler secret put NOMBRE` (ver .env.example).
}

{
  "name": "travest15m0-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:pages": "astro build --config astro.config.pages.mjs",
    "preview:pages": "astro preview --config astro.config.pages.mjs",
    "typecheck": "wrangler types && astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "generate-types": "wrangler types",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "media:hls": "node scripts/video-to-hls.mjs",
    "media:upload": "node scripts/upload-to-r2.mjs",
    "media:serve": "node scripts/serve-media.mjs",
    "media:mix": "node scripts/add-mix.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "astro": "^7.3.3",
    "hls.js": "^1.7.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@aws-sdk/client-s3": "^3.1135.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.2.1",
    "exceljs": "^4.4.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.133.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}

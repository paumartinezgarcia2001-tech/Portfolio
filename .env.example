# Copia este archivo como `.env` (desarrollo local) y rellena lo que haga falta.
# `.env` está en .gitignore: nunca subas valores reales al repo.
#
# En Cloudflare:
#   - las PUBLIC_* van como variables de compilación (Settings → Build → Variables);
#   - el resto, como secrets (Settings → Variables and Secrets → tipo Secret, o
#     `npx wrangler secret put NOMBRE`).
# Para `astro dev` / `astro preview` con workerd también sirve un `.dev.vars`
# con las mismas claves.
#
# Ninguna variable es obligatoria para compilar. Las de la primera parte son las
# que hacen falta para que la web y el panel funcionen; las de la segunda están
# comentadas (#): quita el # y rellénalas solo cuando las necesites. En
# Cloudflare, no añadas las que no uses (mejor borrar la fila que dejarla vacía).

# ============================================================================
# 1. IMPRESCINDIBLES
# ============================================================================

# --- Variables de compilación ----------------------------------------------
# URL pública de la web, sin barra final. Mientras no haya dominio (Q03), la que
# da Cloudflare: https://travest15m0-web.<tu-subdominio>.workers.dev
PUBLIC_SITE_URL=
# Supabase (fase 2): Project Settings → API Keys. Usa la clave nueva sb_publishable_…
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Secret -----------------------------------------------------------------
# Nombre de la página oculta (fase 6). No lo escribas en ningún archivo del repo.
# El panel queda en https://<dominio>/<ADMIN_PATH>. Sin él, el panel no existe (404).
ADMIN_PATH=

# ============================================================================
# 2. OPCIONALES (quita el # cuando hagan falta)
# ============================================================================

# --- Medios (fases 3 y 4) ---------------------------------------------------
# Dominio público del bucket R2, p. ej. https://media.dominio.tld. Sin él, Media
# muestra un aviso y el reproductor dice «reproductor — próximamente». Para
# probar en local sin R2: `npm run media:serve` y http://localhost:4322
# PUBLIC_MEDIA_BASE_URL=

# Token de API de R2 (API S3) con permiso de escritura en el bucket. Los usa
# `npm run media:upload` (en local) y el panel para subir mixes (como secrets del
# Worker: el panel firma la subida y el navegador sube el archivo directamente a
# R2). Usa un token limitado a este bucket con «Object Read & Write».
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=travest15m0-media

# --- Panel (fase 6) ---------------------------------------------------------
# Alias para entrar sin escribir el email: quien escriba ADMIN_USERNAME en
# «usuario» entra con la cuenta ADMIN_EMAIL de Supabase.
# ADMIN_USERNAME=
# ADMIN_EMAIL=

# Turnstile: clave pública del widget (panel de Cloudflare). Hace falta si el
# CAPTCHA de Supabase está activado (Authentication → Attack Protection; allí va
# la clave SECRETA del mismo widget) y para el formulario de contacto.
# Para probar en local: 1x00000000000000000000AA (clave de prueba: siempre pasa).
# PUBLIC_TURNSTILE_SITE_KEY=

# --- Formulario de contacto (apagado: CONTACT_FORM_ENABLED, D60) -------------
# Web3Forms (D58): clave de acceso para el despliegue estático de GitHub Pages.
# Es pública (va escrita en el HTML), pero no se guarda en el repo: se pone como
# variable en GitHub (Settings → Secrets and variables → Actions → Variables).
# En Cloudflare no se usa: allí envía Resend.
# PUBLIC_WEB3FORMS_KEY=

# Resend (fase 5): clave de API, email de Pau (destino; nunca aparece en la web) y
# remitente verificado en Resend, p. ej. web@dominio.tld.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=

# Turnstile: clave secreta del widget, para verificar el formulario en el servidor.
# Para probar en local: 1x0000000000000000000000000000000AA (siempre pasa).
# El límite de 5 envíos por hora usa el namespace de KV CONTACT_RATE_LIMIT
# (wrangler.jsonc; en local lo simula wrangler).
# TURNSTILE_SECRET_KEY=

# --- Solo para scripts locales (nunca en el Worker ni en Cloudflare) ---------
# Supabase: clave secreta sb_secret_… para importar bolos y añadir mixes. Da acceso
# total a la base de datos.
# SUPABASE_SECRET_KEY=

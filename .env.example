# Copia este archivo como `.env` (desarrollo local) y rellena lo que haga falta.
# `.env` está en .gitignore: nunca subas valores reales al repo.
#
# En Cloudflare:
#   - las PUBLIC_* van como variables de compilación y de entorno del Worker;
#   - el resto, como secrets: `npx wrangler secret put NOMBRE`.
# Para `astro dev` / `astro preview` con workerd también sirve un `.dev.vars`
# con las mismas claves.

# --- Públicas ---------------------------------------------------------------
# URL pública de la web, sin barra final (p. ej. https://dominio.tld). Q03.
PUBLIC_SITE_URL=
# Supabase (fase 2): Project Settings → API. Usa la clave nueva sb_publishable_…
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Dominio público del bucket R2 (fases 3 y 4), p. ej. https://media.dominio.tld
# Sin él, Media muestra un aviso en lugar del vídeo. Para probar en local sin
# R2: `npm run media:serve` y http://localhost:4322
PUBLIC_MEDIA_BASE_URL=
# Turnstile (fase 5, formulario de contacto): clave pública del widget, del panel
# de Cloudflare. Sin ella, /contact muestra «formulario — próximamente».
# Para probar en local: 1x00000000000000000000AA (clave de prueba: siempre pasa).
PUBLIC_TURNSTILE_SITE_KEY=
# El login del panel (fase 6) usa el mismo widget: la clave SECRETA de Turnstile
# se pone en Supabase (Authentication → Attack Protection → CAPTCHA), no aquí.
# Web3Forms (D58): clave de acceso que da su panel, para el despliegue estático de
# GitHub Pages, donde no hay servidor que envíe el correo. Es pública (va escrita
# en el HTML), pero no se guarda en el repo: se pone como variable en GitHub
# (Settings → Secrets and variables → Actions → Variables). Sin ella, /contact
# muestra «formulario — próximamente». En Cloudflare no se usa: allí envía Resend.
PUBLIC_WEB3FORMS_KEY=

# --- Secretas (solo servidor) ----------------------------------------------
# Nombre de la página oculta (fase 6). No lo escribas en ningún archivo del repo.
# El panel queda en https://<dominio>/<ADMIN_PATH>. Sin él, el panel no existe (404).
ADMIN_PATH=
# Alias opcional para entrar en el panel sin escribir el email (fase 6): quien
# escriba ADMIN_USERNAME en «usuario» entra con la cuenta ADMIN_EMAIL de Supabase.
ADMIN_USERNAME=
ADMIN_EMAIL=
# Resend (fase 5): clave de API, email de Pau (destino; nunca aparece en la web) y
# remitente verificado en Resend, p. ej. web@dominio.tld.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Turnstile (fase 5): clave secreta del mismo widget.
# Para probar en local: 1x0000000000000000000000000000000AA (siempre pasa).
TURNSTILE_SECRET_KEY=
# El límite de 5 envíos por hora usa el namespace de KV CONTACT_RATE_LIMIT, que se
# declara en wrangler.jsonc (en local lo simula wrangler; no hace falta nada aquí).
# R2 con API S3 (fases 3 y 4): token de API de R2 con permiso de escritura en
# el bucket. Los usa `npm run media:upload` (en local) y, desde la fase 6, el
# panel para subir mixes (como secrets del Worker: el panel firma la subida y el
# navegador sube el archivo directamente a R2). Usa un token limitado a este
# bucket con «Object Read & Write».
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=travest15m0-media

# --- Solo para scripts locales (nunca en el Worker ni en Cloudflare) ---------
# Supabase: clave secreta sb_secret_… para importar bolos y añadir mixes.
SUPABASE_SECRET_KEY=

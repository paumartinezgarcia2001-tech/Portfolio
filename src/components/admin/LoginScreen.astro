---
/**
 * C19 · Entrada al panel: usuario (alias o email) y contraseña.
 *
 * Funciona sin JavaScript (POST a la Action y redirección); con JavaScript,
 * el envío se hace sin recargar (src/scripts/admin/login.ts).
 */
import { actions } from 'astro:actions';
import { ADMIN_TEXT } from '../../config/admin';

interface Props {
  /** Error de un envío sin JavaScript. */
  error?: string | undefined;
}

const configured = Boolean(Astro.locals.admin?.supabase);
const { error } = Astro.props;
---

<main class="a-login" id="main">
  <h1 class="a-title">panel</h1>
  {!configured && <p class="a-alert">{ADMIN_TEXT.notConfigured}</p>}

  {
    configured && (
      <form class="a-form" method="post" action={actions.admin.login} data-admin-login novalidate>
        <div class="a-field" data-field="usuario">
          <label class="a-label" for="login-usuario">
            usuario
          </label>
          <input
            class="a-input"
            id="login-usuario"
            name="usuario"
            type="text"
            autocomplete="username"
            autocapitalize="none"
            spellcheck="false"
            required
            maxlength="254"
          />
          <p class="a-field__error" id="login-usuario-error" data-error-for="usuario" hidden />
        </div>
        <div class="a-field" data-field="password">
          <label class="a-label" for="login-password">
            contraseña
          </label>
          <input
            class="a-input"
            id="login-password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
            maxlength="200"
          />
          <p class="a-field__error" id="login-password-error" data-error-for="password" hidden />
        </div>
        <p class="a-alert" role="alert" data-form-error hidden={!error}>
          {error}
        </p>
        <div class="a-actions">
          <button class="a-btn" type="submit" data-submit>
            entrar
          </button>
        </div>
      </form>
    )
  }
</main>

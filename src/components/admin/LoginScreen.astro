---
/**
 * C19 · Entrada al panel: usuario y contraseña (+ Turnstile) o, si la cuenta
 * tiene TOTP y la sesión aún no lo ha usado, el código de seis cifras.
 *
 * Funciona sin JavaScript si Turnstile no está configurado (POST a la Action y
 * redirección); con Turnstile, el widget necesita JavaScript (D48).
 */
import { actions } from 'astro:actions';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import { ADMIN_TEXT } from '../../config/admin';

interface Props {
  /** Error de un envío sin JavaScript. */
  error?: string | undefined;
}

const admin = Astro.locals.admin;
const configured = Boolean(admin?.supabase);
const mfaStep = admin?.state.kind === 'admin' && admin.state.session.needsMfa;
const siteKey = PUBLIC_TURNSTILE_SITE_KEY;
const { error } = Astro.props;
---

<main class="a-login" id="main">
  <h1 class="a-title">panel</h1>
  {!configured && <p class="a-alert">{ADMIN_TEXT.notConfigured}</p>}

  {
    configured && !mfaStep && (
      <form
        class="a-form"
        method="post"
        action={actions.admin.login}
        data-admin-login
        data-turnstile-sitekey={siteKey}
        novalidate
      >
        <div class="a-field" data-field="usuario">
          <label class="a-label" for="login-usuario">
            usuario
          </label>
          <input
            class="a-input"
            id="login-usuario"
            name="usuario"
            type="text"
            autocomplete="username"
            autocapitalize="none"
            spellcheck="false"
            required
            maxlength="254"
          />
          <p class="a-field__error" id="login-usuario-error" data-error-for="usuario" hidden />
        </div>
        <div class="a-field" data-field="password">
          <label class="a-label" for="login-password">
            contraseña
          </label>
          <input
            class="a-input"
            id="login-password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
            maxlength="200"
          />
          <p class="a-field__error" id="login-password-error" data-error-for="password" hidden />
        </div>
        {siteKey && <div class="a-turnstile" data-turnstile />}
        <p class="a-alert" role="alert" data-form-error hidden={!error}>
          {error}
        </p>
        <div class="a-actions">
          <button class="a-btn" type="submit" data-submit>
            entrar
          </button>
        </div>
      </form>
    )
  }

  {
    configured && mfaStep && (
      <form class="a-form" method="post" action={actions.admin.verifyMfa} data-admin-mfa novalidate>
        <p class="a-lead">Escribe el código de seis cifras de tu app de autenticación.</p>
        <div class="a-field" data-field="codigo">
          <label class="a-label" for="mfa-codigo">
            código
          </label>
          <input
            class="a-input"
            id="mfa-codigo"
            name="codigo"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9 ]*"
            maxlength="7"
            required
          />
          <p class="a-field__error" data-error-for="codigo" hidden />
        </div>
        <p class="a-alert" role="alert" data-form-error hidden={!error}>
          {error}
        </p>
        <div class="a-actions">
          <button class="a-btn" type="submit" data-submit>
            continuar
          </button>
        </div>
      </form>
      <form method="post" action={actions.admin.logout} data-admin-logout>
        <button class="a-btn a-btn--ghost a-btn--small" type="submit">
          salir
        </button>
      </form>
    )
  }
</main>

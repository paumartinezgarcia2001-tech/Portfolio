---
/**
 * C11d · CRT — capa de monitor de tubo encima de toda la web pública.
 * Configuración y niveles del efecto: src/config/crt.ts.
 *
 * La capa no recibe eventos (`pointer-events: none`) y persiste entre
 * navegaciones (`transition:persist`). Va por encima de todo, cursor incluido:
 * es «la pantalla».
 */
import { CRT as CONFIG } from '../config/crt';

const { bloom, curvature } = CONFIG;
/** El filtro SVG (nivel 2) hace falta para la curvatura o para el bloom. */
const useFilter = CONFIG.enabled && (curvature.enabled || bloom.enabled);
/** Umbral del bloom: (c − umbral) / (1 − umbral), recortado a 0…1. */
const bloomSlope = 1 / (1 - bloom.threshold);
const bloomIntercept = -bloom.threshold * bloomSlope;
/** Imagen sobre la que se calcula el bloom: la curvada o la página tal cual. */
const source = curvature.enabled ? 'screen' : 'SourceGraphic';
const style = `--crt-px: ${CONFIG.pixel}px;`;
---

{
  CONFIG.enabled && (
    <div
      class="crt-overlay"
      data-flicker={String(CONFIG.flicker)}
      style={style}
      aria-hidden="true"
      transition:persist="crt-overlay"
    />
  )
}
{
  useFilter && (
    <svg class="crt-filters" aria-hidden="true" focusable="false" transition:persist="crt-filters">
      <filter
        id="crt-screen"
        x="0"
        y="0"
        width="1"
        height="1"
        filterUnits="objectBoundingBox"
        primitiveUnits="userSpaceOnUse"
        color-interpolation-filters="sRGB"
      >
        {
          curvature.enabled && (
            <>
              {/* Curvatura: el mapa de desplazamiento lo genera src/scripts/crt.ts
                  con un <canvas>. */}
              <feImage x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="map" />
              <feDisplacementMap
                in="SourceGraphic"
                in2="map"
                scale="0"
                xChannelSelector="R"
                yChannelSelector="G"
                result="screen"
              />
            </>
          )
        }
        {
          bloom.enabled && (
            <>
              {/* Bloom: se queda solo con lo que pasa del umbral, se desenfoca
                  y se suma encima. */}
              <feComponentTransfer in={source} result="bright">
                <feFuncR type="linear" slope={bloomSlope} intercept={bloomIntercept} />
                <feFuncG type="linear" slope={bloomSlope} intercept={bloomIntercept} />
                <feFuncB type="linear" slope={bloomSlope} intercept={bloomIntercept} />
              </feComponentTransfer>
              <feGaussianBlur in="bright" stdDeviation={bloom.radius} result="glow" />
              <feComposite in={source} in2="glow" operator="arithmetic" k1="0" k2="1" k3={bloom.strength} k4="0" />
            </>
          )
        }
      </filter>
    </svg>
  )
}

<script>
  import '../scripts/crt';
</script>

<style is:global>
  @layer components {
    /* Resplandor y aberración cromática del texto (rojo a un lado, cian al otro). */
    html[data-crt] body {
      text-shadow:
        0.06rem 0 1px rgb(255 0 80 / 0.35),
        -0.06rem 0 1px rgb(0 220 255 / 0.35),
        0 0 4px currentColor;
    }

    .crt-overlay {
      position: fixed;
      inset: 0;
      z-index: var(--z-crt);
      pointer-events: none;
      /* De arriba abajo: viñeta, scanlines y máscara de fósforo RGB, con el
       «píxel» del tubo de `--crt-px` (CRT.pixel). */
      background:
        radial-gradient(ellipse at center, transparent 60%, rgb(0 0 0 / 0.55) 100%),
        repeating-linear-gradient(
          to bottom,
          rgb(0 0 0 / 0.25) 0 var(--crt-px),
          transparent var(--crt-px) calc(var(--crt-px) * 3)
        ),
        repeating-linear-gradient(
          to right,
          rgb(255 0 0 / 0.06) 0 var(--crt-px),
          rgb(0 255 0 / 0.06) var(--crt-px) calc(var(--crt-px) * 2),
          rgb(0 0 255 / 0.06) calc(var(--crt-px) * 2) calc(var(--crt-px) * 3)
        );
      /* En las view transitions queda encima de todo (src/styles/global.css). */
      view-transition-name: crt-overlay;
    }

    .crt-overlay[data-flicker='true'] {
      animation: crt-flicker 0.12s infinite alternate;
    }

    @keyframes crt-flicker {
      from {
        opacity: 0.95;
      }

      to {
        opacity: 1;
      }
    }

    /* Nivel 2 · filtro de pantalla: curvatura y bloom
       (src/scripts/crt.ts pone `data-crt-filter`). */
    .crt-filters {
      position: absolute;
      width: 0;
      height: 0;
      overflow: hidden;
    }

    html[data-crt-filter] body {
      filter: url('#crt-screen');
    }

    @media (prefers-reduced-motion: reduce) {
      .crt-overlay {
        animation: none !important;
      }
    }

    /* Contraste: sin efecto. */
    @media (prefers-contrast: more), (forced-colors: active), print {
      .crt-overlay {
        display: none;
      }

      html[data-crt] body {
        text-shadow: none;
      }

      html[data-crt-filter] body {
        filter: none;
      }
    }
  }
</style>

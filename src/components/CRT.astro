---
/**
 * C11d · CRT — capa de monitor de tubo encima de toda la web pública.
 * Configuración y niveles del efecto: src/config/crt.ts.
 *
 * La capa no recibe eventos (`pointer-events: none`) y persiste entre
 * navegaciones (`transition:persist`). Va por encima de todo, cursor incluido:
 * es «la pantalla».
 */
import { CRT as CONFIG } from '../config/crt';

const { bloom, curvature } = CONFIG;
/** El filtro SVG (nivel 2) solo hace falta para la curvatura. */
const useFilter = CONFIG.enabled && curvature.enabled;
const style = `--crt-px: ${CONFIG.pixel}px;`;
/** Medidas del bloom para el CSS de abajo (se aplica con `html[data-crt-bloom]`). */
const bloomVars = `:root{--crt-bloom-r:${bloom.radius}px;--crt-bloom-a:${Math.round(bloom.strength * 100)}%;}`;
---

{
  CONFIG.enabled && (
    <div
      class="crt-overlay"
      data-flicker={String(CONFIG.flicker)}
      style={style}
      aria-hidden="true"
      transition:persist="crt-overlay"
    />
  )
}
{
  useFilter && (
    <svg class="crt-filters" aria-hidden="true" focusable="false" transition:persist="crt-filters">
      <filter
        id="crt-screen"
        x="0"
        y="0"
        width="1"
        height="1"
        filterUnits="objectBoundingBox"
        primitiveUnits="userSpaceOnUse"
        color-interpolation-filters="sRGB"
      >
        {
          curvature.enabled && (
            <>
              {/* Curvatura: el mapa de desplazamiento lo genera src/scripts/crt.ts
                  con un <canvas>. */}
              <feImage x="0" y="0" width="1" height="1" preserveAspectRatio="none" result="map" />
              <feDisplacementMap
                in="SourceGraphic"
                in2="map"
                scale="0"
                xChannelSelector="R"
                yChannelSelector="G"
                result="screen"
              />
            </>
          )
        }
      </filter>
    </svg>
  )
}

{CONFIG.enabled && bloom.enabled && <style is:inline set:html={bloomVars} />}

<script>
  import '../scripts/crt';
</script>

<style is:global>
  @layer components {
    /* Resplandor y aberración cromática del texto (rojo a un lado, cian al
       otro). En una variable para que el bloom pueda sumarle su halo. */
    html[data-crt] {
      --crt-text-shadow:
        0.06rem 0 1px rgb(255 0 80 / 0.35), -0.06rem 0 1px rgb(0 220 255 / 0.35), 0 0 4px currentColor;
    }

    html[data-crt] body {
      text-shadow: var(--crt-text-shadow);
    }

    .crt-overlay {
      position: fixed;
      inset: 0;
      z-index: var(--z-crt);
      pointer-events: none;
      /* De arriba abajo: viñeta, scanlines y máscara de fósforo RGB, con el
       «píxel» del tubo de `--crt-px` (CRT.pixel). */
      background:
        radial-gradient(ellipse at center, transparent 60%, rgb(0 0 0 / 0.55) 100%),
        repeating-linear-gradient(
          to bottom,
          rgb(0 0 0 / 0.25) 0 var(--crt-px),
          transparent var(--crt-px) calc(var(--crt-px) * 3)
        ),
        repeating-linear-gradient(
          to right,
          rgb(255 0 0 / 0.06) 0 var(--crt-px),
          rgb(0 255 0 / 0.06) var(--crt-px) calc(var(--crt-px) * 2),
          rgb(0 0 255 / 0.06) calc(var(--crt-px) * 2) calc(var(--crt-px) * 3)
        );
      /* En las view transitions queda encima de todo (src/styles/global.css). */
      view-transition-name: crt-overlay;
      /* Capa propia desde el principio: el parpadeo solo cambia su opacidad y
         lo hace la GPU, sin volver a pintar la página. */
      will-change: opacity;
    }

    .crt-overlay[data-flicker='true'] {
      animation: crt-flicker 0.12s infinite alternate;
    }

    @keyframes crt-flicker {
      from {
        opacity: 0.95;
      }

      to {
        opacity: 1;
      }
    }

    /*
     * Bloom (BaseLayout pone `html[data-crt-bloom]`). Halo de luz alrededor de
     * lo que brilla de verdad: los neones del color de la sección (barra de
     * noticias, ítem del menú, rotulador, cursor). Antes era un filtro SVG
     * sobre toda la página, que el navegador recalculaba en cada fotograma
     * mientras algo se movía (la barra, el parpadeo, el cursor, el vídeo):
     * iba a tirones, sobre todo en móvil. Así solo se pinta alrededor de esos
     * elementos y casi no cuesta.
     */
    /* Sin halo con más contraste, colores forzados ni al imprimir. */
    @media screen and (forced-colors: none) and (prefers-contrast: no-preference) {
      /* Doble halo: uno corto e intenso y otro ancho y suave. `--glow` es el
         color de cada elemento (la variable se resuelve en el propio elemento). */
      html[data-crt-bloom] :is(.ticker, .menu__link, .hl, .prose a, .cursor) {
        --crt-glow:
          0 0 calc(var(--crt-bloom-r) / 3) color-mix(in srgb, var(--glow) 80%, transparent),
          0 0 var(--crt-bloom-r) color-mix(in srgb, var(--glow) var(--crt-bloom-a), transparent);
      }

      html[data-crt-bloom] .ticker {
        --glow: var(--accent);

        box-shadow: var(--crt-glow);
      }

      html[data-crt-bloom] .menu__link:is([aria-current='page'], :hover, :focus-visible) {
        --glow: var(--item-color);

        text-shadow: var(--crt-text-shadow), var(--crt-glow);
      }

      html[data-crt-bloom] :is(.hl, .prose a) {
        --glow: var(--hl-ink);

        box-shadow: var(--crt-glow);
      }

      /* Donde el rotulador solo sale al pasar el ratón, el halo también. */
      html[data-crt-bloom] .embed__link a:not(:hover, :focus-visible) {
        box-shadow: none;
      }

      html[data-crt-bloom].has-cursor .cursor[data-shape='circle'] {
        --glow: var(--cursor-color, var(--accent));

        box-shadow: var(--crt-glow);
      }

      html[data-crt-bloom] .player__button:not(:disabled):is(:hover, :focus-visible) {
        filter: drop-shadow(0 0 calc(var(--crt-bloom-r) / 3) currentColor);
      }
    }

    /* Nivel 2 · curvatura (filtro SVG; src/scripts/crt.ts pone `data-crt-filter`). */
    .crt-filters {
      position: absolute;
      width: 0;
      height: 0;
      overflow: hidden;
    }

    html[data-crt-filter] body {
      filter: url('#crt-screen');
    }

    @media (prefers-reduced-motion: reduce) {
      .crt-overlay {
        animation: none !important;
      }
    }

    /* Contraste: sin efecto. */
    @media (prefers-contrast: more), (forced-colors: active), print {
      .crt-overlay {
        display: none;
      }

      html[data-crt] body {
        text-shadow: none;
      }

      html[data-crt-filter] body {
        filter: none;
      }
    }
  }
</style>

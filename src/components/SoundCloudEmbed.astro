---
/**
 * C17 · SoundCloudEmbed — el reproductor de SoundCloud en contact (D59).
 *
 * Con `SOUNDCLOUD.eager` (así está ahora, Luna ✓ 02-10-2026) el reproductor ya
 * viene puesto: se ve nada más abrir contact y no suena hasta que le dan al
 * play. Con `eager: false` lo que llega es una **fachada** —un enlace de verdad
 * a SoundCloud, que es lo que se usa sin JavaScript— y el reproductor aparece,
 * ya sonando, al pulsarla.
 *
 * En los dos casos, src/scripts/soundcloud-embed.ts se encarga de que la música
 * de la web y SoundCloud no suenen a la vez.
 */
import { SITE } from '../config/site';
import { SOCIAL_TEXT, SOUNDCLOUD, soundcloudPlayerUrl } from '../config/social';

const TEXT = SOCIAL_TEXT.soundcloud;
---

<section class="embed" aria-labelledby="escucha-heading">
  <h2 class="embed__heading" id="escucha-heading">{TEXT.heading}</h2>

  <soundcloud-embed
    class="sc"
    data-state={SOUNDCLOUD.eager ? 'ready' : 'idle'}
    data-player-src={soundcloudPlayerUrl({ autoPlay: true })}
    data-frame-height={String(SOUNDCLOUD.height)}
    data-frame-title={TEXT.frameTitle}
    data-load-label={TEXT.load}
    data-native-cursor
  >
    {
      SOUNDCLOUD.eager ? (
        <iframe
          src={soundcloudPlayerUrl()}
          title={TEXT.frameTitle}
          width="100%"
          height={String(SOUNDCLOUD.height)}
          loading="lazy"
          frameborder="no"
          scrolling="no"
          allow="autoplay; encrypted-media"
        />
      ) : (
        /* El mismo elemento es la fachada y, después, el hueco del iframe. */
        <a class="sc__facade" href={SITE.social.soundcloud} target="_blank" rel="noopener" data-facade data-load>
          <span class="sc__title">{SOUNDCLOUD.trackTitle}</span>
          <span class="sc__action" data-action>
            {TEXT.openLabel}
            <span aria-hidden="true"> ↗</span>
            <span class="visually-hidden"> (se abre en otra pestaña)</span>
          </span>
        </a>
      )
    }
  </soundcloud-embed>

  {/* El enlace al perfil, justo debajo del reproductor (Luna ✓ 02-10-2026). */}
  <p class="embed__link">
    <a class="hl" href={SITE.social.soundcloud} target="_blank" rel="noopener">
      {TEXT.profileLabel}
      <span aria-hidden="true"> ↗</span>
      <span class="visually-hidden"> (se abre en otra pestaña)</span>
    </a>
  </p>
</section>

<script>
  import '../scripts/soundcloud-embed';
</script>

<style>
  @layer components {
    /* `.embed`, `.embed__heading` y `.embed__notice` son comunes con
       InstagramPosts.astro y están en src/styles/global.css. */
    /* A todo el ancho de la columna: el padre centra sus hijos, así que sin
       esto el reproductor se quedaría del tamaño de su contenido. */
    .sc {
      display: block;
      width: 100%;
    }

    .sc__facade {
      display: grid;
      gap: 0.2em;
      padding: 1rem;
      border: var(--rule-w) solid var(--c-panel-fg);
      color: inherit;
      text-decoration: none;
      /* Zona táctil de sobra (§10). */
      min-height: 44px;
    }

    .sc__title {
      font-size: calc(var(--fs-paragraph) * 1.4);
      line-height: var(--lh-paragraph);
      text-transform: uppercase;
    }

    .sc__action {
      font-size: var(--fs-small);
      line-height: var(--lh-paragraph);
    }

    /* Resaltado naranja al pasar el ratón (rotulador de D39). */
    .sc__facade:where(:hover, :focus-visible) {
      background: var(--accent);
      --cursor-over: var(--c-panel-fg);
    }

    /* Con el reproductor puesto, el hueco ya no es un botón: fuera el relleno. */
    .sc[data-state='ready'] .sc__facade {
      display: block;
      padding: 0;
      border: 0;
      background: none;
    }

    .sc[data-state='ready'] .sc__facade:where(:hover, :focus-visible) {
      background: none;
    }

    .sc iframe {
      display: block;
      width: 100%;
      border: 0;
    }
  }
</style>

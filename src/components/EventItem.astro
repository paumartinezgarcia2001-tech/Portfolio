---
/**
 * C13 · EventItem — un bolo: fecha grande, nombre de la fiesta, sala y
 * ciudad, y lineup (a la derecha en escritorio, debajo en móvil).
 * La fecha va resaltada con rotulador (D39); el nombre, también en el
 * archivo (D19) o cuando enlaza a las entradas.
 */
import { formatEventDate } from '../lib/dates';
import type { Gig } from '../lib/data/core';

interface Props {
  gig: Gig;
  variant: 'next' | 'archive';
  /** Posición en la lista: elige la variante del trazo para que no se repita. */
  index?: number;
}

const { gig, variant, index = 0 } = Astro.props;
const name = gig.partyName ?? 'TBA';
const lineup = gig.lineup.length > 0 ? gig.lineup.join(', ') : 'TBA';
const dateStroke = String((index % 3) + 1);
const nameStroke = String(((index + 1) % 3) + 1);
---

<article class="event">
  <div class="event__main">
    <time class="event__date" datetime={gig.eventDate}
      ><span class="hl hl--double" data-hl={dateStroke}>{formatEventDate(gig.eventDate)}</span></time
    >
    <h2 class="event__name">
      {
        gig.ticketUrl ? (
          <a class="event__link hl" data-hl={nameStroke} href={gig.ticketUrl} target="_blank" rel="noopener">
            {name}
            <span class="visually-hidden"> (entradas, se abre en otra pestaña)</span>
          </a>
        ) : variant === 'archive' ? (
          <span class="hl" data-hl={nameStroke}>{name}</span>
        ) : (
          name
        )
      }
    </h2>
    <p class="event__place">{gig.venue}, {gig.city}</p>
  </div>
  <p class="event__lineup">{lineup}</p>
</article>

<style>
  @layer components {
    /* Sin separación entre eventos (brief): ni líneas ni márgenes. */
    .event {
      display: grid;
      align-items: start;
      content-visibility: auto;
      contain-intrinsic-size: auto 14rem;
      /* `content-visibility` recorta lo que se sale de la caja: se agranda
         hacia fuera (sin mover nada) para no cortar el rotulador. El <li> es
         un elemento de rejilla, así que estos márgenes no colapsan con él. */
      margin: -0.5rem -1rem;
      padding: 0.5rem 1rem;
    }

    .event__main {
      /* La fecha y el nombre se miden respecto al ancho de esta columna. */
      container-type: inline-size;
      min-width: 0;
    }

    .event__date {
      display: block;
      font-size: 9.4cqi;
      font-weight: var(--fw-regular);
      line-height: var(--lh-tight);
      white-space: nowrap;
    }

    .event__name {
      margin-top: 0.12em;
      font-size: 5.2cqi;
      font-weight: var(--fw-bold);
      line-height: 1.05;
      text-transform: uppercase;
      overflow-wrap: anywhere;
    }


    .event__place,
    .event__lineup {
      font-size: var(--fs-small);
      line-height: var(--lh-paragraph);
    }

    .event__place {
      margin-top: 0.3em;
    }

    .event__lineup {
      margin-top: 0.3em;
      text-align: left;
      overflow-wrap: anywhere;
    }

    @media (min-width: 1024px) {
      .event {
        grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
        column-gap: var(--pad);
      }

      /* Lineup en la columna derecha, alineado arriba. */
      .event__lineup {
        margin-top: 0;
      }
    }
  }
</style>

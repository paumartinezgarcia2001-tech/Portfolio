---
/**
 * C17 · ContactForm — formulario de contacto (fase 5, tres campos desde D58).
 *
 * Dos caminos de envío, según dónde esté alojada la web:
 * - **Cloudflare** (`astro.config.mjs`): va a la Action `contact.send`, que
 *   valida con zod, comprueba Turnstile, cuenta los envíos y llama a Resend.
 * - **GitHub Pages** (`astro.config.pages.mjs`, STATIC_BUILD): no hay servidor,
 *   así que va a la API de Web3Forms (prop `web3forms`). Sin Turnstile y sin
 *   límite de envíos: lo explica src/lib/contact/web3forms.ts.
 *
 * Los dos funcionan sin JavaScript, con un POST normal del formulario: al
 * acabar se llega a /mensaje-enviado. Con JavaScript
 * (src/scripts/contact-form.ts) se envía sin recargar, así la música no se
 * corta. La excepción es Cloudflare sin JavaScript: allí Turnstile lo necesita,
 * y por eso sale el aviso del <noscript>.
 */
import { actions } from 'astro:actions';
import {
  CONTACT_FIELDS as FIELD,
  CONTACT_FIELD_ERRORS as FIELD_ERROR,
  CONTACT_LIMITS as LIMITS,
  CONTACT_TEXT as TEXT,
  PHONE_PATTERN,
  contactErrorText,
} from '../config/contact';
import type { ContactValues } from '../lib/contact/values';
import { WEB3FORMS_ENDPOINT, WEB3FORMS_FIELDS, WEB3FORMS_FROM_NAME, WEB3FORMS_SUBJECT } from '../lib/contact/web3forms';
import { withBase } from '../lib/url';

interface Props {
  /**
   * Envío por Web3Forms (build estático). `accessKey` es pública por diseño
   * (va en el HTML); `redirect`, la dirección absoluta de /mensaje-enviado.
   */
  web3forms?: { accessKey: string; redirect: string } | undefined;
  /** PUBLIC_TURNSTILE_SITE_KEY. Solo con servidor. */
  siteKey?: string | undefined;
  /** Lo escrito en el envío anterior (solo sin JavaScript, en Cloudflare). */
  values?: ContactValues | undefined;
  /** Errores por campo que devuelve la Action. */
  fieldErrors?: Record<string, string[] | undefined> | undefined;
  /** Código de error general (límite, Turnstile, envío…). */
  errorCode?: string | undefined;
}

const { web3forms, siteKey, values = {}, fieldErrors, errorCode } = Astro.props;

const errorOf = (field: string): string | undefined => fieldErrors?.[field]?.[0];
const describedBy = (field: string, hint?: string) =>
  [errorOf(field) ? `contact-${field}-error` : undefined, hint].filter(Boolean).join(' ') || undefined;
const invalid = (field: string) => (errorOf(field) ? 'true' : undefined);
/** El primer campo con error recibe el foco al recargar (sin JavaScript). */
const firstInvalid = [FIELD.email, FIELD.phone, FIELD.message].find((field) => errorOf(field));
---

<form
  class="contact-form"
  method="post"
  action={web3forms ? WEB3FORMS_ENDPOINT : actions.contact.send}
  data-contact-form
  data-static={web3forms ? 'true' : undefined}
  data-state="idle"
>
  {
    web3forms && (
      <>
        {/* Campos reservados de Web3Forms. `redirect` solo lo usa el envío sin
            JavaScript: con JavaScript el aviso se muestra aquí mismo. */}
        <input type="hidden" name={WEB3FORMS_FIELDS.accessKey} value={web3forms.accessKey} />
        <input type="hidden" name={WEB3FORMS_FIELDS.subject} value={WEB3FORMS_SUBJECT} />
        <input type="hidden" name={WEB3FORMS_FIELDS.fromName} value={WEB3FORMS_FROM_NAME} />
        <input type="hidden" name={WEB3FORMS_FIELDS.redirect} value={web3forms.redirect} data-redirect />
      </>
    )
  }

  <div class="field" data-field={FIELD.email} data-invalid={invalid(FIELD.email)}>
    <label class="field__label" for={`contact-${FIELD.email}`}>{TEXT.labels.email}</label>
    <input
      class="field__input"
      id={`contact-${FIELD.email}`}
      name={FIELD.email}
      type="email"
      inputmode="email"
      autocomplete="email"
      spellcheck="false"
      required
      maxlength={LIMITS.emailMax}
      value={values.email}
      aria-invalid={invalid(FIELD.email)}
      aria-describedby={describedBy(FIELD.email)}
      autofocus={firstInvalid === FIELD.email || undefined}
    />
    <p
      class="field__error"
      id={`contact-${FIELD.email}-error`}
      data-error-for={FIELD.email}
      hidden={!errorOf(FIELD.email)}
    >
      {errorOf(FIELD.email)}
    </p>
  </div>

  <div class="field" data-field={FIELD.phone} data-invalid={invalid(FIELD.phone)}>
    <label class="field__label" for={`contact-${FIELD.phone}`}>
      {TEXT.labels.phone} <span class="field__optional">{TEXT.optional}</span>
    </label>
    <input
      class="field__input"
      id={`contact-${FIELD.phone}`}
      name={FIELD.phone}
      type="tel"
      inputmode="tel"
      autocomplete="tel"
      maxlength={LIMITS.phoneMax}
      pattern={PHONE_PATTERN}
      title={FIELD_ERROR.phoneInvalid}
      value={values.telefono}
      aria-invalid={invalid(FIELD.phone)}
      aria-describedby={describedBy(FIELD.phone)}
      autofocus={firstInvalid === FIELD.phone || undefined}
    />
    <p
      class="field__error"
      id={`contact-${FIELD.phone}-error`}
      data-error-for={FIELD.phone}
      hidden={!errorOf(FIELD.phone)}
    >
      {errorOf(FIELD.phone)}
    </p>
  </div>

  <div class="field" data-field={FIELD.message} data-invalid={invalid(FIELD.message)}>
    <label class="field__label" for={`contact-${FIELD.message}`}>{TEXT.labels.message}</label>
    <textarea
      class="field__input field__textarea"
      id={`contact-${FIELD.message}`}
      name={FIELD.message}
      rows="5"
      required
      minlength={LIMITS.messageMin}
      maxlength={LIMITS.messageMax}
      aria-invalid={invalid(FIELD.message)}
      aria-describedby={describedBy(FIELD.message)}
      autofocus={firstInvalid === FIELD.message || undefined}>{values.mensaje}</textarea
    >
    <p
      class="field__error"
      id={`contact-${FIELD.message}-error`}
      data-error-for={FIELD.message}
      hidden={!errorOf(FIELD.message)}
    >
      {errorOf(FIELD.message)}
    </p>
  </div>

  {/* Honeypot (`botcheck`): casilla escondida con `style` en línea, como pide
      Web3Forms. Fuera del foco y del lector de pantalla; si llega marcada, el
      mensaje se descarta. */}
  <input
    id={`contact-${FIELD.honeypot}`}
    name={FIELD.honeypot}
    type="checkbox"
    style="display: none;"
    tabindex="-1"
    aria-hidden="true"
  />

  {
    siteKey && (
      /* Widget de Turnstile (lo pinta el script). El cursor propio se oculta encima (C10). */
      <div class="field">
        <span class="field__label" id="contact-turnstile-label">
          {TEXT.labels.turnstile}
        </span>
        <div
          class="contact-form__turnstile"
          data-turnstile
          data-sitekey={siteKey}
          data-native-cursor
          aria-labelledby="contact-turnstile-label"
        />
        <noscript>
          <p class="contact-form__noscript">{TEXT.noscript}</p>
        </noscript>
      </div>
    )
  }

  {/* Error general (límite, Turnstile, envío). Sin JavaScript llega ya pintado;
      con JavaScript lo rellena el script. «reintentar» es un submit más, así
      que también funciona sin JavaScript. */}
  <div class="contact-form__alert" id="contact-form-error" role="alert" tabindex="-1" data-form-error hidden={!errorCode}>
    <p class="contact-form__alert-text" data-form-error-text>{errorCode ? contactErrorText(errorCode) : ''}</p>
    <button class="contact-form__retry" type="submit">{TEXT.retry}</button>
  </div>

  <div class="contact-form__actions">
    <button class="contact-form__submit" type="submit" data-submit>{TEXT.submit}</button>
    <p class="visually-hidden" id="contact-form-status" role="status" aria-live="polite" data-status></p>
  </div>

  <p class="contact-form__privacy">
    {TEXT.labels.privacyBefore} <a class="hl" href={withBase('/privacidad')}>{TEXT.labels.privacyLink}</a>.
  </p>
</form>

<script>
  import '../scripts/contact-form';
</script>

<style>
  @layer components {
    .contact-form {
      display: grid;
      gap: var(--pad);
      max-width: 40rem;
      margin: 0 0 calc(var(--pad) * 2);
    }

    /* Al enviarse bien, el script lo oculta (`hidden`): las reglas de esta capa
       ganan a la del navegador, así que hay que decirlo aquí. */
    .contact-form[hidden] {
      display: none;
    }

    .field {
      display: grid;
      gap: 0.35rem;
    }

    .field__label {
      font-size: var(--fs-label);
      line-height: var(--lh-paragraph);
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .field__optional {
      text-transform: none;
      letter-spacing: 0;
    }

    .field__input {
      width: 100%;
      padding: 0.1em 0.1em 0.15em;
      border: 0;
      border-bottom: var(--rule-w) solid var(--c-panel-fg);
      border-radius: 0;
      background: none;
      font-size: var(--fs-paragraph);
      line-height: var(--lh-paragraph);
      appearance: none;
    }

    .field__textarea {
      min-height: 6em;
      resize: vertical;
      field-sizing: content;
    }

    /* Foco: contorno oscuro con halo naranja (global) sin recorte. */
    .field__input:focus-visible {
      outline-offset: 2px;
    }

    /* Campo con error: además del texto, el borde se dobla. Se queda oscuro a
       propósito: el naranja sobre el panel claro no llega a 3:1 (§4.1) y el
       borde es lo que delimita el campo. */
    .field[data-invalid] .field__input {
      border-bottom-width: calc(var(--rule-w) * 2);
    }

    .field__error {
      font-size: var(--fs-small);
      line-height: var(--lh-paragraph);
    }

    .field__error[hidden] {
      display: none;
    }

    .contact-form__turnstile {
      /* Hueco del widget (300 × 65): así no salta el contenido al aparecer. */
      min-height: 65px;
    }

    .contact-form__noscript,
    .contact-form__privacy {
      max-width: 34rem;
      font-size: var(--fs-small);
      line-height: var(--lh-paragraph);
    }

    .contact-form__alert {
      display: grid;
      gap: 0.5rem;
      justify-items: start;
      padding: 0.75rem;
      border: var(--rule-w) solid var(--c-panel-fg);
      font-size: var(--fs-small);
      line-height: var(--lh-paragraph);
    }

    .contact-form__alert[hidden] {
      display: none;
    }

    .contact-form__actions {
      display: flex;
      align-items: center;
      gap: var(--pad);
    }

    .contact-form__submit,
    .contact-form__retry {
      padding: 0.1em 0.25em;
      border: var(--rule-w) solid var(--c-panel-fg);
      color: inherit;
      line-height: var(--lh-paragraph);
      /* Zona táctil mínima de 44 px (§10). */
      min-height: 44px;
    }

    .contact-form__submit {
      font-size: calc(var(--fs-paragraph) * 1.4);
    }

    .contact-form__retry {
      font-size: var(--fs-small);
    }

    /* Resaltado naranja al pasar el ratón (rotulador de D39). */
    .contact-form__submit:where(:hover, :focus-visible),
    .contact-form__retry:where(:hover, :focus-visible) {
      background: var(--accent);
      --cursor-over: var(--c-panel-fg);
    }

    /* Mientras envía: el botón queda desactivado. */
    .contact-form__submit[disabled] {
      cursor: default;
      opacity: 0.6;
    }

    .contact-form[data-state='sending'] .contact-form__submit {
      background: none;
    }
  }
</style>

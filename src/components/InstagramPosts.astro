---
/**
 * C17 · InstagramPosts — publicaciones destacadas de Instagram en contact (D59).
 *
 * Se ven nada más abrir la página (Luna ✓ 02-10-2026). Cada publicación sale
 * como el `blockquote` del embed oficial de Instagram, con su enlace dentro:
 * eso es lo que se ve sin JavaScript (y mientras `embed.js` carga), y lo que
 * `embed.js` sustituye por la publicación de verdad
 * (src/scripts/instagram-posts.ts).
 *
 * **No es el perfil entero**: Meta no deja incrustarlo (su oEmbed rechaza las
 * URLs de perfil y su API de feeds pide cuenta profesional y un token que
 * caduca cada 60 días). Debajo queda un enlace al perfil.
 *
 * Qué publicaciones se destacan se decide en `INSTAGRAM_POSTS`
 * (src/config/social.ts). Con la lista vacía, este componente no pinta nada.
 */
import { SITE } from '../config/site';
import { INSTAGRAM_EMBED_VERSION, SOCIAL_TEXT, instagramPostUrl, instagramPosts } from '../config/social';

interface Props {
  /** Publicaciones a destacar. Por defecto, las de `INSTAGRAM_POSTS`. */
  posts?: readonly string[] | undefined;
}

const TEXT = SOCIAL_TEXT.instagram;
const posts = Astro.props.posts
  ? [...new Set(Astro.props.posts.map(instagramPostUrl).filter((url): url is string => Boolean(url)))]
  : instagramPosts();
---

{
  posts.length > 0 && (
    <section class="embed" aria-labelledby="instagram-heading">
      <h2 class="embed__heading" id="instagram-heading">
        {TEXT.heading}
      </h2>

      <instagram-posts class="ig" data-state="idle" data-native-cursor>
        {posts.map((url, index) => (
          <blockquote
            class="instagram-media"
            data-instgrm-permalink={url}
            data-instgrm-version={INSTAGRAM_EMBED_VERSION}
            data-post
          >
            {/* Lo que se ve sin JavaScript y mientras carga el embed. */}
            <a class="ig__link hl" href={url} target="_blank" rel="noopener">
              {TEXT.postLabel(index + 1)}
              <span aria-hidden="true"> ↗</span>
              <span class="visually-hidden"> (se abre en otra pestaña)</span>
            </a>
          </blockquote>
        ))}
      </instagram-posts>

      <p class="ig__profile">
        <a class="ig__link hl" href={SITE.social.instagram} target="_blank" rel="noopener">
          {TEXT.profileLabel}
          <span aria-hidden="true"> ↗</span>
          <span class="visually-hidden"> (se abre en otra pestaña)</span>
        </a>
      </p>
    </section>
  )
}

<script>
  import '../scripts/instagram-posts';
</script>

<style>
  @layer components {
    /* `.embed`, `.embed__heading` y `.embed__notice` son comunes con
       SoundCloudEmbed.astro y están en src/styles/global.css. */
    .ig {
      display: grid;
      gap: var(--pad);
      width: 100%;
      max-width: 100%;
    }

    /* Antes de que cargue el embed, cada publicación es solo su enlace: sin la
       caja del `blockquote`, que si no se ven cuatro marcos vacíos. */
    .ig :global(blockquote.instagram-media:not(.instagram-media-rendered)) {
      margin: 0;
      padding: 0;
      border: 0;
      font-size: var(--fs-paragraph);
      line-height: var(--lh-paragraph);
    }

    /* Ya cargado: las reglas que inyecta Instagram llevan !important, y su
       ancho mínimo de 326 px sacaría scroll horizontal en móvil. */
    .ig :global(.instagram-media) {
      min-width: 0 !important;
      max-width: 100% !important;
      margin: 0 auto !important;
    }

    .ig__profile {
      margin: 0;
      font-size: var(--fs-small);
      line-height: var(--lh-paragraph);
    }

    /* El rotulador (D39) solo al pasar el ratón o con el foco. */
    .ig__link:not(:hover, :focus-visible) {
      background: none;
    }
  }
</style>

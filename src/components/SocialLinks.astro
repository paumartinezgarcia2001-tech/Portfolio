---
/**
 * C17 · SocialLinks — el email de Pau al final de contact (fase 5, D58, D59).
 *
 * Desde D58 aquí está el email como enlace `mailto:` (Luna, 25-09-2026), que
 * abre el programa de correo y por eso no lleva `target`. Los enlaces a
 * SoundCloud y a Instagram **ya no están aquí**: desde el 02-10-2026 (Luna ✓)
 * cada uno va justo debajo de su widget, dentro de SoundCloudEmbed.astro y de
 * InstagramPosts.astro.
 */
import { SITE } from '../config/site';
---

<p class="social">
  <a class="social__link hl" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
</p>

<style>
  @layer components {
    .social {
      margin: 0;
      /* El email es largo: en móvil tiene que poder partirse. */
      font-size: var(--fs-paragraph);
      line-height: var(--lh-paragraph);
      overflow-wrap: anywhere;
    }

    /* El rotulador (D39) solo al pasar el ratón o con el foco. */
    .social__link:not(:hover, :focus-visible) {
      background: none;
    }
  }
</style>

---
/**
 * C17 · SocialLinks — el email de Pau en contact (fase 5, D58, D59, D60).
 *
 * Desde D60 (Luna ✓ 03-10-2026) **no hay formulario**: este enlace `mailto:` es
 * la forma de escribir a Pau, y por eso va donde estaba el formulario y en
 * grande. Abre el programa de correo, así que no lleva `target`.
 *
 * Los enlaces a SoundCloud y a Instagram no están aquí: desde D59 cada uno va
 * justo debajo de su widget (SoundCloudEmbed.astro e InstagramPosts.astro).
 */
import { SITE } from '../config/site';
---

<p class="social">
  <a class="social__link hl" href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>
</p>

<style>
  @layer components {
    .social {
      margin: 0;
      /* Es la llamada a la acción de la página: en grande, como las redes. */
      font-size: calc(var(--fs-paragraph) * 1.4);
      line-height: var(--lh-paragraph);
      /* El email es largo: en móvil tiene que poder partirse. */
      overflow-wrap: anywhere;
    }

    /* El rotulador (D39) solo al pasar el ratón o con el foco. */
    .social__link:not(:hover, :focus-visible) {
      background: none;
    }
  }
</style>

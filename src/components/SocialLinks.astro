---
/**
 * C17 · SocialLinks — los enlaces grandes de contact (fase 5).
 *
 * SoundCloud, Instagram y, desde D58, el email de Pau como enlace `mailto:`
 * (Luna, 25-09-2026). Los dos primeros abren en otra pestaña; el correo abre el
 * programa de correo, así que no lleva `target`.
 */
import { SITE } from '../config/site';

const LINKS = [
  { label: 'SoundCloud', href: SITE.social.soundcloud, external: true },
  { label: 'Instagram', href: SITE.social.instagram, external: true },
  { label: SITE.contactEmail, href: `mailto:${SITE.contactEmail}`, external: false },
] as const;
---

<ul class="social" role="list">
  {
    LINKS.map((link) => (
      <li>
        {link.external ? (
          <a class="social__link hl" href={link.href} target="_blank" rel="noopener">
            {link.label}
            <span aria-hidden="true"> ↗</span>
            <span class="visually-hidden"> (se abre en otra pestaña)</span>
          </a>
        ) : (
          <a class="social__link social__link--mail hl" href={link.href}>
            {link.label}
          </a>
        )}
      </li>
    ))
  }
</ul>

<style>
  @layer components {
    .social {
      display: grid;
      justify-items: start;
      gap: 0.2em;
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: calc(var(--fs-paragraph) * 1.4);
      line-height: var(--lh-paragraph);
    }

    /* El rotulador (D39) solo al pasar el ratón o con el foco. */
    .social__link:not(:hover, :focus-visible) {
      background: none;
    }

    /* El email es más largo que «SoundCloud»: en móvil tiene que poder partirse. */
    .social__link--mail {
      font-size: var(--fs-paragraph);
      overflow-wrap: anywhere;
    }
  }
</style>

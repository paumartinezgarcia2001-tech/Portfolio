---
/**
 * C01 · BaseLayout — documento común de todas las páginas públicas.
 * El panel oculto usa su propio AdminLayout, sin efectos.
 */
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import CRT from '../components/CRT.astro';
import CustomCursor from '../components/CustomCursor.astro';
import MobileBackButton from '../components/MobileBackButton.astro';
import PixelOverlay from '../components/PixelOverlay.astro';
import SeoHead from '../components/SeoHead.astro';
import SplitShell from '../components/SplitShell.astro';
import { CRT as CRT_CONFIG } from '../config/crt';
import { DEFAULT_THEME } from '../config/theme';
import { getSiteTheme } from '../lib/data';
import { themeCss } from '../lib/theme';
import type { SectionState } from '../config/sections';
import { MOBILE_START_VIEW, SITE } from '../config/site';

interface Props {
  section: SectionState;
  /** Título de la sección (se completa con « — travest15m0»). */
  title: string;
  description?: string | undefined;
  noindex?: boolean | undefined;
  /** Texto del <h1>; por defecto, `title`. */
  heading?: string | undefined;
  /** Idioma del <h1> si no es español. */
  headingLang?: string | undefined;
}

const { section, title, description, noindex, heading = title, headingLang } = Astro.props;
// Lo carga src/middleware.ts; si no está (p. ej. en el 404 de un recurso), se usa el texto por defecto.
const tickerText = Astro.locals.tickerText;
// Colores elegidos en el panel (src/lib/theme.ts). Las secciones los traen del
// middleware; el resto de páginas los pide aquí. `null` = los del código.
const theme = Astro.locals.theme !== undefined ? Astro.locals.theme : await getSiteTheme();
// Móvil: las secciones abren en el menú (D44); la 404, en la página.
const startView = section === 'none' ? 'page' : MOBILE_START_VIEW;
---

<!doctype html>
<html
  lang={SITE.lang}
  data-section={section}
  data-view={startView}
  data-crt={CRT_CONFIG.enabled ? '' : undefined}
  data-crt-bloom={CRT_CONFIG.enabled && CRT_CONFIG.bloom.enabled ? '' : undefined}
  transition:animate="none"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* Orden de las capas CSS: tiene que ser la primera hoja de estilo del documento. */}
    <style is:inline>
      @layer astro, reset, tokens, base, components, utilities;
    </style>
    <SeoHead title={title} description={description} noindex={noindex}>
      <slot name="head" />
    </SeoHead>
    {/* Colores del panel: sin capa, mandan sobre src/styles/tokens.css. Solo lleva colores validados. */}
    {theme && <style is:inline data-theme set:html={themeCss(theme)} />}
    <meta name="theme-color" content={(theme ?? DEFAULT_THEME).menuBg} />
    <meta name="color-scheme" content="only light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
    {/* Sin JavaScript, en móvil no se puede cambiar de capa (D44: la web abre
        en el menú): el menú y la página se apilan y todo queda a la vista.
        Va en <noscript> para que no
        parpadee mientras carga el script. Sin capa, gana a los componentes. */}
    <noscript>
      <style is:inline>
        @media (max-width: 1023.98px) {
          html,
          body {
            height: auto;
            overflow: visible;
          }

          .shell {
            height: auto;
            overflow: visible;
          }

          #left {
            position: relative;
            left: 0;
            visibility: visible;
          }

          #panel {
            height: auto;
            min-height: 100dvh;
            visibility: visible;
            padding-top: calc(var(--pad) + var(--safe-top));
          }

          [data-back-button] {
            display: none;
          }
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#panel" data-skip-link>Saltar al contenido</a>
    <MobileBackButton />
    <SplitShell section={section} heading={heading} headingLang={headingLang} tickerText={tickerText}>
      <slot />
    </SplitShell>
    <PixelOverlay />
    <CustomCursor />
    <CRT />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>

<style>
  @layer components {
    .skip-link {
      position: fixed;
      top: var(--pad);
      left: var(--pad);
      z-index: calc(var(--z-cursor) + 1);
      padding: 0.5em 0.75em;
      background: var(--c-panel-bg);
      color: var(--c-panel-fg);
      font-size: var(--fs-small);
      text-decoration: none;
      translate: 0 calc(-100% - var(--pad) - 1rem);
    }

    .skip-link:focus-visible {
      translate: 0 0;
    }
  }
</style>

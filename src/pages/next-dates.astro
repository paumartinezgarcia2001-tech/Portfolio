---
/**
 * C14 · Next dates — bolos publicados de hoy en adelante (corte a las 08:00
 * del día siguiente, hora de Madrid), en orden ascendente.
 */
import DataNotice from '../components/DataNotice.astro';
import EventList from '../components/EventList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUpcomingGigs } from '../lib/data';
import { musicEventLd, toJsonLd } from '../lib/seo';

const { data: gigs, ok } = await getUpcomingGigs();
if (!ok && Astro.cache.enabled) Astro.cache.set(false);
---

<BaseLayout
  section="next"
  title="next dates"
  headingLang="en"
  description="Próximas fechas de travest15m0, DJ en Madrid."
>
  {
    gigs.map((gig) => (
      <script type="application/ld+json" is:inline slot="head" set:html={toJsonLd(musicEventLd(gig))} />
    ))
  }
  {
    gigs.length > 0 ? (
      <EventList events={gigs} variant="next" label="Próximas fechas" />
    ) : ok ? (
      <div class="events-empty">
        <p class="events-empty__text">
          <span class="hl hl--double" data-hl="1">PRÓXIMAS FECHAS POR ANUNCIAR</span>
        </p>
      </div>
    ) : (
      <DataNotice what="las próximas fechas" />
    )
  }
</BaseLayout>

<style>
  @layer components {
    .events-empty {
      container-type: inline-size;
    }

    /* Mismo estilo que una fecha (C13 y C14), con el rotulador (D39). */
    .events-empty__text {
      font-size: 9.4cqi;
      font-weight: var(--fw-regular);
      line-height: var(--lh-tight);
    }
  }
</style>

---
/**
 * C18 · 404 — dentro del mismo layout, con el menú visible.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout section="none" title="404" heading="404" description="Esta página no existe." noindex>
  <div class="not-found">
    <p class="not-found__code" aria-hidden="true">404</p>
    <p class="not-found__text">Esta página no existe.</p>
    <p><a class="hl" href={withBase('/')}>volver a info</a></p>
  </div>
</BaseLayout>

<style>
  @layer components {
    .not-found {
      display: grid;
      gap: var(--pad);
    }

    .not-found__code {
      font-size: clamp(6rem, 20vw, 16rem);
      font-weight: var(--fw-regular);
      line-height: var(--lh-tight);
    }

    /* En móvil el <h1> ya muestra «404». */
    @media (max-width: 1023.98px) {
      .not-found__code {
        display: none;
      }
    }
  }
</style>

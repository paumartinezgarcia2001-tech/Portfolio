---
/**
 * C16 · Archive — bolos publicados anteriores a hoy, del más reciente al más
 * antiguo. Variante `archive`: solo el nombre de la fiesta, resaltado con el
 * rotulador verde; la fecha, sin resaltar (D45).
 */
import DataNotice from '../components/DataNotice.astro';
import EventList from '../components/EventList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPastGigs } from '../lib/data';

const { data: gigs, ok } = await getPastGigs();
if (!ok && Astro.cache.enabled) Astro.cache.set(false);
---

<BaseLayout
  section="archive"
  title="archive"
  headingLang="en"
  description="Archivo de sesiones de travest15m0, DJ en Madrid."
>
  {
    gigs.length > 0 ? (
      <EventList events={gigs} variant="archive" label="Archivo de fechas" />
    ) : (
      !ok && <DataNotice what="las fechas del archivo" />
    )
  }
</BaseLayout>

---
/**
 * C17 · Contact — correo y redes (D58–D60).
 *
 * Sin formulario: arriba, el email de Pau como enlace `mailto:`; debajo, el
 * reproductor de SoundCloud y las publicaciones de Instagram, cada uno con su
 * enlace al perfil (D59).
 */
import InstagramPosts from '../components/InstagramPosts.astro';
import SocialLinks from '../components/SocialLinks.astro';
import SoundCloudEmbed from '../components/SoundCloudEmbed.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

/** Frase de entrada de la página. */
const INTRO = 'Booking, prensa y colaboraciones.';
---

<BaseLayout
  section="contact"
  title="contact"
  headingLang="en"
  description="Booking, prensa y colaboraciones con travest15m0."
>
  <div class="contact">
    <p class="contact__intro">{INTRO}</p>
    <SocialLinks />
    <SoundCloudEmbed />
    <InstagramPosts />
  </div>
</BaseLayout>

<style>
  @layer components {
    .contact {
      display: grid;
      justify-items: start;
      gap: var(--pad);
      /* Sin tope de ancho (Luna ✓ 02-10-2026): los widgets de redes ocupan
         todo lo que da la columna de la página. */
    }

    .contact__intro {
      font-size: var(--fs-small);
      line-height: var(--lh-paragraph);
    }
  }
</style>

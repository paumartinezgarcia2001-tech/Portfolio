---
/**
 * C12 · Info — se abre por defecto. Texto en src/content/info.md o, si se ha
 * guardado desde el panel (P2, fase 6), el de `site_settings.info_markdown`.
 */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getInfoMarkdown } from '../lib/data';
import { renderInfoMarkdown } from '../lib/markdown';
import { withBase } from '../lib/url';

const entry = await getEntry('pages', 'info');
if (!entry) throw new Error('Falta src/content/info.md');
const override = await getInfoMarkdown();
const html = override.data ? renderInfoMarkdown(override.data, { resolveInternal: withBase }) : null;
const { Content } = await render(entry);
---

<BaseLayout section="info" title={entry.data.title} headingLang="en">
  {
    html ? (
      <article class="prose info" data-info-source="panel" set:html={html} />
    ) : (
      <article class="prose info">
        <Content />
      </article>
    )
  }
</BaseLayout>

<style>
  @layer components {
    .prose {
      max-width: 44rem;
      font-size: var(--fs-paragraph);
      line-height: var(--lh-paragraph);
    }

    /* Bloques: titulillo en mayúsculas (Regular) con separador de 2 px. */
    .prose :global(h2) {
      margin: 2.5rem 0 0.75rem;
      padding-top: 0.5rem;
      border-top: var(--rule-w) solid var(--c-panel-fg);
      font-size: var(--fs-label);
      font-weight: var(--fw-regular);
      letter-spacing: 0.04em;
      line-height: var(--lh-paragraph);
      text-transform: uppercase;
    }

    .prose :global(h2:first-child) {
      margin-top: 0;
    }

    .prose :global(p) {
      margin: 0;
      text-align: justify;
      hyphens: auto;
      -webkit-hyphens: auto;
      hyphenate-limit-chars: 7 3 3;
      text-wrap: pretty;
    }

    .prose :global(p + p) {
      margin-top: 1em;
    }

    /* Enlaces: rotulador con el acento (src/styles/highlighter.css, D39).
       #27272B sobre el neón ≥4,7:1. */
    .prose :global(a) {
      hyphens: manual;
    }
  }
</style>

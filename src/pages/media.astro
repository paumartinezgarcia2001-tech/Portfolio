---
/**
 * C15 · Media — vídeo a sangre, servido en HLS desde R2 (`<media-video>`).
 * Sin pixelado (D40). Sin `PUBLIC_MEDIA_BASE_URL` (el dominio del bucket),
 * un aviso discreto en su lugar.
 */
import MediaVideo from '../components/MediaVideo.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMediaVideo } from '../lib/data';

const video = await getMediaVideo();
---

<BaseLayout section="media" title="media" headingLang="en" description="Vídeo de travest15m0, DJ en Madrid.">
  {
    video?.origin && (
      <Fragment slot="head">
        {/* El póster (sin CORS) y hls.js (con CORS) usan conexiones distintas. */}
        <link rel="preconnect" href={video.origin} />
        <link rel="preconnect" href={video.origin} crossorigin />
      </Fragment>
    )
  }
  {
    video ? (
      <MediaVideo video={video} />
    ) : (
      <div class="media-stage">
        <p class="media-notice" role="status">vídeo — próximamente</p>
      </div>
    )
  }
</BaseLayout>

<style>
  @layer components {
    .media-stage {
      display: grid;
      place-items: center;
      min-height: 100%;
      padding: var(--pad);
    }

    .media-notice {
      font-size: var(--fs-small);
    }
  }
</style>

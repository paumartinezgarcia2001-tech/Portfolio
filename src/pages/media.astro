---
/**
 * C15 · Media.
 * - Por defecto, el muro animado (`<media-wall>`, D65): fotos, bucles de vídeo
 *   y rótulos de bolos que caen por todo el panel. Se apaga con
 *   `MEDIA_WALL.enabled` (src/config/media-wall.ts).
 * - Con el muro apagado, el vídeo a sangre de siempre (`<media-video>`, HLS
 *   desde R2, sin pixelado: D40).
 * Sin `PUBLIC_MEDIA_BASE_URL` (el dominio del bucket), un aviso discreto.
 */
import MediaVideo from '../components/MediaVideo.astro';
import MediaWall from '../components/MediaWall.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMediaVideo, getMediaWall } from '../lib/data';

const wall = await getMediaWall();
const video = wall ? null : await getMediaVideo();
const origin = wall?.origin ?? video?.origin ?? null;
---

<BaseLayout
  section="media"
  title="media"
  headingLang="en"
  description={wall ? 'Fotos y vídeos de travest15m0, DJ en Madrid.' : 'Vídeo de travest15m0, DJ en Madrid.'}
>
  {
    origin && (
      <Fragment slot="head">
        {/* Las imágenes y vídeos del muro van con CORS (WebGL); el póster del vídeo, sin. */}
        <link rel="preconnect" href={origin} />
        <link rel="preconnect" href={origin} crossorigin />
      </Fragment>
    )
  }
  {
    wall ? (
      <MediaWall wall={wall} />
    ) : video ? (
      <MediaVideo video={video} />
    ) : (
      <div class="media-stage">
        <p class="media-notice" role="status">vídeo — próximamente</p>
      </div>
    )
  }
</BaseLayout>

<style>
  @layer components {
    .media-stage {
      display: grid;
      place-items: center;
      min-height: 100%;
      padding: var(--pad);
    }

    .media-notice {
      font-size: var(--fs-small);
    }
  }
</style>
